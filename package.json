{
  "name": "interview",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/main.ts",
    "test": "node --import tsx --test --test-timeout=10000 \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "lint": "oxlint --type-aware",
    "typecheck": "tsc",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "npm run format:check && npm run typecheck && npm run lint"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "oxfmt": "0.42.0",
    "oxlint": "1.57.0",
    "oxlint-tsgolint": "0.18.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
